# Database Configuration
# DB_TYPE=sqlite (default) - Use local SQLite database (jobs.db)
# DB_TYPE=turso        - Use Turso cloud database
DB_TYPE=sqlite

# Turso Cloud Database (only needed if DB_TYPE=turso)
TURSO_DATABASE_URL=libsql://your-db-name.aws-region.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
